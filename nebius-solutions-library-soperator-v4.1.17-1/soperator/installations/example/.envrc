set -o pipefail

retry_script="$(dirname "${BASH_SOURCE[0]}")/../../modules/scripts/retry.sh"

retry_nebius() {
  "$retry_script" -- nebius "$@"
}

NEBIUS_TENANT_ID="$NEBIUS_TENANT_ID" # ='tenant-...'
NEBIUS_PROJECT_ID="$NEBIUS_PROJECT_ID" # ='project-...'
NEBIUS_REGION="${NEBIUS_REGION:-eu-north1}"

# O11y setup.
NEBIUS_OLLY_PROFILE="${NEBIUS_OLLY_PROFILE:-soperator-telemetry}"
NEBIUS_OLLY_TENANT_ID="${NEBIUS_OLLY_TENANT_ID:-tenant-e00vyb5y1x5vqkzw5e}" # ='tenant-...'

if [ -z "${NEBIUS_TENANT_ID}" ]; then
  echo "Error: NEBIUS_TENANT_ID is not set"
  return 1
fi

if [ -z "${NEBIUS_PROJECT_ID}" ]; then
  echo "Error: NEBIUS_PROJECT_ID is not set"
  return 1
fi

# region IAM token

unset NEBIUS_IAM_TOKEN
retry_nebius iam whoami > /dev/null
NEBIUS_IAM_TOKEN=$(retry_nebius iam get-access-token)
export NEBIUS_IAM_TOKEN

if [ -f "$HOME/.nebius/credentials.yaml" ]; then
  IAM_TOKEN_EXPIRES_AT=$(yq '.tokens[].expires_at' "$HOME/.nebius/credentials.yaml" 2>/dev/null)
  if [ -n "$IAM_TOKEN_EXPIRES_AT" ]; then
    if [[ "$(uname)" == "Darwin" ]]; then
      echo "IAM token expires at: $(date -r "$IAM_TOKEN_EXPIRES_AT")"
    else
      echo "IAM token expires at: $(date -d @"$IAM_TOKEN_EXPIRES_AT")"
    fi
  fi
fi

# endregion IAM token

# region VPC subnet

NEBIUS_VPC_SUBNET_ID=$(retry_nebius vpc subnet list \
  --parent-id "${NEBIUS_PROJECT_ID}" \
  --format json \
  | jq -r '.items[0].metadata.id')
export NEBIUS_VPC_SUBNET_ID

# endregion VPC subnet

# region Remote state

# region Backend override
#
# Candidate sandbox backend: a bucket + access key were pre-provisioned and
# delivered separately (candidate-soperator.env + the backend secret file),
# so we skip the stock self-service SA/access-key/bucket provisioning above
# and just wire up the given backend.
#
# Security note: access_key / secret_key are deliberately NOT written into
# terraform_backend_override.tf (or any other file). The S3 backend falls
# back to the standard AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY env vars
# when those fields are omitted from the backend block, so the secret only
# ever lives in the shell environment -- never on disk in a Terraform file.

if [ -z "${TF_BACKEND_BUCKET}" ] || [ -z "${TF_BACKEND_KEY}" ] || \
   [ -z "${TF_BACKEND_AWS_ACCESS_KEY_ID}" ] || [ -z "${TF_BACKEND_AWS_SECRET_ACCESS_KEY}" ]; then
  echo "Error: TF_BACKEND_BUCKET/TF_BACKEND_KEY/TF_BACKEND_AWS_ACCESS_KEY_ID/TF_BACKEND_AWS_SECRET_ACCESS_KEY are not all set (source candidate-soperator.env and the backend secret file first)"
  return 1
fi

AWS_ACCESS_KEY_ID="${TF_BACKEND_AWS_ACCESS_KEY_ID}"
export AWS_ACCESS_KEY_ID

AWS_SECRET_ACCESS_KEY="${TF_BACKEND_AWS_SECRET_ACCESS_KEY}"
export AWS_SECRET_ACCESS_KEY

AWS_REGION="${NEBIUS_REGION}"
export AWS_REGION

AWS_ENDPOINT_URL="https://storage.${NEBIUS_REGION}.nebius.cloud:443"
export AWS_ENDPOINT_URL

cat > terraform_backend_override.tf << EOF
terraform {
  backend "s3" {
    bucket = "${TF_BACKEND_BUCKET}"
    key    = "${TF_BACKEND_KEY}"

    endpoints = {
      s3 = "https://storage.${NEBIUS_REGION}.nebius.cloud:443"
    }
    region = "${NEBIUS_REGION}"

    use_lockfile                = true
    use_path_style              = true
    skip_region_validation      = true
    skip_credentials_validation = true
    skip_requesting_account_id  = true
    skip_metadata_api_check     = true
    skip_s3_checksum            = true
  }
}
EOF

# endregion Backend override

# endregion Remote state

# region TF variables

export TF_VAR_region="${NEBIUS_REGION}"
export TF_VAR_iam_token="${NEBIUS_IAM_TOKEN}"
export TF_VAR_iam_tenant_id="${NEBIUS_TENANT_ID}"
export TF_VAR_iam_project_id="${NEBIUS_PROJECT_ID}"
export TF_VAR_o11y_iam_tenant_id="${NEBIUS_OLLY_TENANT_ID}"
export TF_VAR_o11y_profile="${NEBIUS_OLLY_PROFILE}"
export TF_VAR_vpc_subnet_id="${NEBIUS_VPC_SUBNET_ID}"
export TFE_PARALLELISM=20

echo "Exported variables:"
echo "TF_VAR_region: ${TF_VAR_region}"
echo "TF_VAR_iam_tenant_id: ${TF_VAR_iam_tenant_id}"
echo "TF_VAR_iam_project_id: ${TF_VAR_iam_project_id}"
echo "TF_VAR_o11y_iam_tenant_id: ${TF_VAR_o11y_iam_tenant_id}"
echo "TF_VAR_o11y_profile: ${TF_VAR_o11y_profile}"
echo "TF_VAR_vpc_subnet_id: ${TF_VAR_vpc_subnet_id}"
echo "TFE_PARALLELISM: ${TFE_PARALLELISM}"

# endregion TF variables
